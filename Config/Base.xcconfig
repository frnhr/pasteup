// Shared build settings.
//
// Signing defaults to ad-hoc ("-"). Ad-hoc builds lose the Accessibility permission on every rebuild,
// so for real use copy Local.xcconfig.example to Local.xcconfig (gitignored) and fill in your team.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
