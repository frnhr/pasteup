// Copy to Local.xcconfig (gitignored) and fill in your Team ID.
// Team IDs known to Xcode: `defaults read com.apple.dt.Xcode IDEProvisioningTeams`
// A free Personal Team works. The first build with -allowProvisioningUpdates creates the certificate.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = ABCDE12345
